{
  "mcpServers": {
    "argocd": {
      "command": "uvx",
      "args": [
        "mcp-argocd@0.8.0"
      ],
      "env": {
        "ARGOCD_TOKEN": "${user_config.argocd_token}",
        "ARGOCD_URL": "${user_config.argocd_url}",
        "MCP_READ_ONLY": "${user_config.mcp_read_only}"
      }
    }
  }
}
