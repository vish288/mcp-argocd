# Argo CD base URL, including any path prefix (required)
ARGOCD_URL=https://argocd.example.com

# Bearer token (required) — any of these work, checked in this order:
# - ARGOCD_TOKEN
# - ARGOCD_AUTH_TOKEN (the argocd CLI's name)
# - ARGOCD_API_TOKEN (the official server's name)
# Generate one: argocd account generate-token --account <name> --expires-in 24h
ARGOCD_TOKEN=

# Optional settings
# Lock the server read-only. MCP_READ_ONLY is the shared name across the mcp-* servers;
# ARGOCD_READ_ONLY is the per-server alias. Either being truthy locks it; a falsy value
# never unlocks. Set it in a launch the deployer owns so no client can override it.
# MCP_READ_ONLY=false
# ARGOCD_READ_ONLY=false
# ARGOCD_TIMEOUT=30
# ARGOCD_SSL_VERIFY=true
# ARGOCD_INSECURE=false
# ARGOCD_APP_NAMESPACE=
